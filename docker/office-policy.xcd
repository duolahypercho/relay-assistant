<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: MIT. Relay defaults for the isolated document apps. -->
<oor:data xmlns:oor="http://openoffice.org/2001/registry">
  <dependency file="main"/>
  <oor:component-data oor:name="Common" oor:package="org.openoffice.Office">
    <node oor:name="Security">
      <node oor:name="Scripting">
        <prop oor:name="DisableMacrosExecution" oor:finalized="true"><value>true</value></prop>
      </node>
    </node>
    <node oor:name="Misc">
      <prop oor:name="ShowTipOfTheDay"><value>false</value></prop>
    </node>
    <node oor:name="Path">
      <node oor:name="Current">
        <prop oor:name="Work"><value>file:///workspace</value></prop>
      </node>
    </node>
  </oor:component-data>
  <oor:component-data oor:name="Paths" oor:package="org.openoffice.Office">
    <node oor:name="Paths">
      <node oor:name="Work" oor:op="fuse">
        <prop oor:name="WritePath"><value>file:///workspace</value></prop>
      </node>
    </node>
  </oor:component-data>
  <oor:component-data oor:name="Impress" oor:package="org.openoffice.Office">
    <node oor:name="Misc">
      <node oor:name="NewDoc">
        <prop oor:name="AutoPilot"><value>false</value></prop>
      </node>
    </node>
  </oor:component-data>
</oor:data>
