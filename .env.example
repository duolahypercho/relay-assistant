# Start with fictional sample data; live starts an empty workspace on first run.
RELAY_MODE=sample
RELAY_HOST=127.0.0.1
# Development defaults to 5173, production to 4173. Set both values together if overriding.
# RELAY_PORT=5173
# RELAY_PUBLIC_URL=http://127.0.0.1:5173
# RELAY_DATA_DIR=./data

# Required when binding beyond loopback. Generate your own long random key.
RELAY_ACCESS_KEY=

# Optional read-only connection. You can also add multiple connections in Settings.
# Protocol: responses, chat, anthropic or gemini. Values are server-only.
RELAY_MODEL_PROTOCOL=responses
# Chat Completions only: set false for endpoints without stream_options support.
RELAY_MODEL_REPORT_USAGE=true
RELAY_MODEL_BASE_URL=
RELAY_MODEL_ID=
RELAY_MODEL_API_KEY=

# Optional server defaults for voice input. You can also connect and test audio in Settings.
# Explicitly choose an audio-transcriptions compatible service.
# Example base URL: https://api.openai.com/v1, model: gpt-4o-mini-transcribe
# Audio goes to this service only after the owner chooses Transcribe.
RELAY_TRANSCRIPTION_BASE_URL=
RELAY_TRANSCRIPTION_MODEL=
RELAY_TRANSCRIPTION_API_KEY=

# Optional server defaults for speech. In-app settings can select saved connections or Off.
# Separate from dictation and the chat model.
# Example base URL: https://api.openai.com/v1, model: gpt-4o-mini-tts
RELAY_SPEECH_BASE_URL=
RELAY_SPEECH_MODEL=
RELAY_SPEECH_API_KEY=
RELAY_SPEECH_VOICE=coral

# Optional image generation, also configurable from Personalize > Create with AI.
# No chat credentials are reused. Nothing is generated until the owner clicks Generate.
# Format: gpt-image (GPT Image) or base64 (Images API with response_format: b64_json).
RELAY_IMAGE_BASE_URL=
RELAY_IMAGE_MODEL=
RELAY_IMAGE_API_KEY=
RELAY_IMAGE_FORMAT=gpt-image

# Your own Google OAuth web client and random 32-byte base64 encryption key.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RELAY_TOKEN_ENCRYPTION_KEY=

# Optional sourced web search.
BRAVE_SEARCH_API_KEY=

# A separate persistent browser profile; never your personal browser session.
RELAY_BROWSER_ENABLED=true
# RELAY_BROWSER_CHANNEL=chrome

# Opt-in offline Docker terminal; build docker/workspace.Dockerfile first.
# Private Linux desktop with persistent files and agent/owner control.
# docker build -f docker/desktop.Dockerfile -t relay-desktop:local .
# On macOS, Colima is supported; point DOCKER_HOST at its Docker socket if needed.
# Leave unset to offer setup in the Computer page. Set false to disable owner setup.
# RELAY_DESKTOP_ENABLED=false
# RELAY_DESKTOP_IMAGE=relay-desktop:local
# For an administrator-managed separate VM, see docs/REMOTE_COMPUTER.md.
# Set RELAY_DESKTOP_ENABLED=true, keep RELAY_COMPUTER_ENABLED=false, and remove
# DOCKER_HOST, DOCKER_CONTEXT and RELAY_DESKTOP_IMAGE before setting this path.
# RELAY_REMOTE_COMPUTER_FILE=/run/relay-computer/connection.json
# Website connections require an owner grant; disable this to keep the desktop offline.
RELAY_DESKTOP_WEB_ENABLED=true
# Experimental separate browser runtime + authenticated owner API. Requires the
# private computer image and a local engine or pinned remote connection. Its restricted
# browser container has no direct network or workspace/display mounts. Broader
# credential/taint, exploit and live-account/device acceptance remain unfinished.
RELAY_TRUSTED_BROWSER_ENABLED=false
RELAY_COMPUTER_ENABLED=false
RELAY_COMPUTER_IMAGE=relay-workspace:local

# Optional native mobile notifications. Keys stay outside the repository.
# Enable separately on each device in More > Settings. See docs/NOTIFICATIONS.md.
RELAY_APNS_KEY_PATH=
RELAY_APNS_KEY_ID=
RELAY_APNS_TEAM_ID=
RELAY_APNS_TOPIC=org.relay.assistant
RELAY_APNS_ENVIRONMENT=development
RELAY_FCM_SERVICE_ACCOUNT=

# Optional installed video decoders (absolute paths). Otherwise use PATH / standard locations.
# Video inspection requires current FFmpeg/ffprobe with the seekable fd protocol.
# RELAY_FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# RELAY_FFPROBE_PATH=/opt/homebrew/bin/ffprobe

# Hosted deployments can read private mounted files instead of direct key values.
# Set either the direct value or its _FILE counterpart, never both.
# RELAY_ACCESS_KEY_FILE=/run/relay-secrets/current/access-key
# RELAY_TOKEN_ENCRYPTION_KEY_FILE=/run/relay-secrets/current/token-key
